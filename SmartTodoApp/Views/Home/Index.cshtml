@model IEnumerable<SmartTodoApp.Models.TodoItem>

@{
    ViewData["Title"] = "Smart To-Do List";
}

<div class="container mt-5" style="max-width: 700px;">
    <div class="text-center mb-4">
        <h1 class="fw-bold text-primary">📝 Smart To-Do App</h1>
        <p class="text-muted">Manage your daily tasks easily with ASP.NET Core & SQLite</p>
    </div>

    <!-- Task Add Form -->
    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body">
            <form asp-action="Add" method="post" class="row g-2">
                <div class="col-md-9">
                    <input type="text" name="title" class="form-control form-control-lg" placeholder="What needs to be done?" required autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">Add Task</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Task List -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <ul class="list-group list-group-flush">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center py-3 px-4">
                            <span class="fs-5 text-dark">@item.Title</span>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm px-3">Delete</a>
                        </li>
                    }
                }
                else
                {
                    <li class="list-group-item text-center py-4 text-muted">
                        No tasks yet. Add one above to get started! 🚀
                    </li>
                }
            </ul>
        </div>
    </div>
</div>